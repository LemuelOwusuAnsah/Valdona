<section class="card">
  <h2>Generate</h2>
  <div class="range-row">
    <span>Length</span>
    <span class="value" id="lengthVal">16</span>
  </div>
  <input type="range" id="length" min="8" max="32" value="16" />
  <div class="opts">
    <label class="opt"><input id="optUpper" type="checkbox" checked /> Uppercase</label>
    <label class="opt"><input id="optLower" type="checkbox" checked /> Lowercase</label>
    <label class="opt"><input id="optDigits" type="checkbox" checked /> Digits</label>
    <label class="opt"><input id="optSymbols" type="checkbox" checked /> Symbols</label>
    <label class="opt"><input id="optExclude" type="checkbox" /> Exclude ambiguous</label>
  </div>
  <button id="generate" class="btn btn-primary" type="button">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12a9 9 0 1 1-3-6.7"/>
      <polyline points="21 3 21 9 15 9"/>
    </svg>
    Generate password
  </button>
  <div class="output">
    <code id="generated">&mdash;</code>
    <button id="copy" class="copy-btn" type="button" aria-label="Copy">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2"/>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
      </svg>
    </button>
  </div>
</section>

<style>
  .range-row { display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; color: var(--fg-muted); font-weight: 500; margin-bottom: 0.5rem; }
  .range-row .value { font-family: var(--mono); font-size: 0.8rem; color: var(--fg); background: var(--bg); border: 1px solid var(--border); padding: 0.1rem 0.5rem; border-radius: 6px; }
  input[type='range'] { width: 100%; height: 4px; appearance: none; background: var(--border); border-radius: var(--radius-pill); outline: none; margin-bottom: 1.25rem; }
  input[type='range']::-webkit-slider-thumb { appearance: none; width: 16px; height: 16px; border-radius: 50%; background: var(--fg); border: none; cursor: pointer; }
  input[type='range']::-moz-range-thumb { width: 16px; height: 16px; border-radius: 50%; background: var(--fg); border: none; cursor: pointer; }
  .opts { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem 1rem; margin-bottom: 1.25rem; }
  .opt { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; color: var(--fg); cursor: pointer; }
  .opt input[type='checkbox'] { width: 16px; height: 16px; accent-color: var(--fg); cursor: pointer; }
  .btn { width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.75rem 1rem; border-radius: var(--radius-pill); border: 1px solid transparent; font: inherit; font-weight: 500; font-size: 0.9rem; cursor: pointer; transition: background 0.15s, border-color 0.15s; }
  .btn-primary { background: var(--fg); color: var(--bg); }
  .btn-primary:hover { opacity: 0.9; }
  .btn-primary svg { width: 16px; height: 16px; }
  .output { display: flex; align-items: center; gap: 0.5rem; margin-top: 1rem; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); padding: 0.6rem 0.4rem 0.6rem 0.9rem; word-break: break-all; }
  .output code { flex: 1; font-family: var(--mono); font-size: 0.85rem; color: var(--fg); }
  .copy-btn { background: transparent; border: none; color: var(--fg-muted); cursor: pointer; padding: 0.4rem; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; }
  .copy-btn:hover { color: var(--fg); background: var(--border); }
  .copy-btn svg { width: 16px; height: 16px; }
</style>
