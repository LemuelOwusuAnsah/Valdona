<section class="card">
  <h2>Generate</h2>

  <div class="mode-toggle" role="tablist" aria-label="Generation mode">
    <button type="button" id="modePassword" class="mode-btn active" role="tab" aria-selected="true">Password</button>
    <button type="button" id="modePassphrase" class="mode-btn" role="tab" aria-selected="false">Passphrase</button>
  </div>

  <div id="passwordControls" class="controls">
    <div class="range-row">
      <span>Length</span>
      <span class="value" id="lengthVal">16</span>
    </div>
    <input type="range" id="length" min="8" max="64" value="16" />

    <div class="opts">
      <label class="opt"><input id="optUpper" type="checkbox" checked /> Uppercase</label>
      <label class="opt"><input id="optLower" type="checkbox" checked /> Lowercase</label>
      <label class="opt"><input id="optDigits" type="checkbox" checked /> Digits</label>
      <label class="opt"><input id="optSymbols" type="checkbox" checked /> Symbols</label>
      <label class="opt"><input id="optExclude" type="checkbox" /> Exclude ambiguous</label>
    </div>
  </div>

  <div id="passphraseControls" class="controls" style="display:none;">
    <div class="range-row">
      <span>Words</span>
      <span class="value" id="wordCountVal">6</span>
    </div>
    <input type="range" id="wordCount" min="3" max="10" value="6" />

    <div class="range-row">
      <span>Separator</span>
      <input type="text" id="separator" class="sep-input" value="-" maxlength="3" />
    </div>

    <div class="opts">
      <label class="opt"><input id="optCapitalize" type="checkbox" /> Capitalize</label>
      <label class="opt"><input id="optNumber" type="checkbox" /> Include number</label>
    </div>
  </div>

  <div class="range-row">
    <span>Count</span>
    <span class="value" id="bulkVal">1</span>
  </div>
  <input type="range" id="bulkCount" min="1" max="1000" value="1" />
  <p id="bulkWarn" class="bulk-warn" style="display:none;">Generating many passwords may take a moment.</p>

  <button id="generate" class="btn btn-primary" type="button">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 12a9 9 0 1 1-3-6.7"/>
      <polyline points="21 3 21 9 15 9"/>
    </svg>
    Generate
  </button>

  <div id="singleOutput" class="output">
    <code id="generated">&mdash;</code>
    <button id="copy" class="copy-btn" type="button" aria-label="Copy">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="9" y="9" width="13" height="13" rx="2"/>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
      </svg>
    </button>
  </div>

  <div id="bulkOutput" class="bulk-output" style="display:none;">
    <ul id="bulkList" class="bulk-list"></ul>
  </div>

  <div class="actions-row">
    <button id="exportTxt" class="btn btn-ghost" type="button" disabled>Export .txt</button>
    <button id="clearOutput" class="btn btn-ghost" type="button" disabled>Clear</button>
  </div>

  <div class="history">
    <div class="history-head">
      <span>Session history</span>
      <button id="clearHistory" class="link-btn" type="button">Clear</button>
    </div>
    <ul id="historyList" class="history-list"></ul>
  </div>
</section>

<style>
  .mode-toggle { display: flex; gap: 0.25rem; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius-pill); padding: 0.25rem; margin-bottom: 1.25rem; }
  .mode-btn { flex: 1; background: transparent; border: none; font: inherit; font-size: 0.85rem; font-weight: 500; color: var(--fg-muted); cursor: pointer; padding: 0.4rem 0.75rem; border-radius: var(--radius-pill); transition: background 0.15s, color 0.15s; }
  .mode-btn.active { background: var(--fg); color: var(--bg); }
  .controls { margin-bottom: 1.25rem; }
  .range-row { display: flex; justify-content: space-between; align-items: center; font-size: 0.85rem; color: var(--fg-muted); font-weight: 500; margin-bottom: 0.5rem; }
  .range-row .value { font-family: var(--mono); font-size: 0.8rem; color: var(--fg); background: var(--bg); border: 1px solid var(--border); padding: 0.1rem 0.5rem; border-radius: 6px; }
  .sep-input { width: 60px; font-family: var(--mono); font-size: 0.85rem; color: var(--fg); background: var(--bg); border: 1px solid var(--border); border-radius: 6px; padding: 0.15rem 0.5rem; text-align: center; outline: none; }
  .sep-input:focus { border-color: var(--border-strong); }
  input[type='range'] { width: 100%; height: 4px; appearance: none; background: var(--border); border-radius: var(--radius-pill); outline: none; margin-bottom: 1rem; }
  input[type='range']::-webkit-slider-thumb { appearance: none; width: 16px; height: 16px; border-radius: 50%; background: var(--fg); border: none; cursor: pointer; }
  input[type='range']::-moz-range-thumb { width: 16px; height: 16px; border-radius: 50%; background: var(--fg); border: none; cursor: pointer; }
  .opts { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem 1rem; margin-bottom: 0.25rem; }
  .opt { display: flex; align-items: center; gap: 0.5rem; font-size: 0.875rem; color: var(--fg); cursor: pointer; }
  .opt input[type='checkbox'] { width: 16px; height: 16px; accent-color: var(--fg); cursor: pointer; }
  .bulk-warn { font-size: 0.78rem; color: var(--warning); margin: 0 0 0.75rem; }
  .btn { width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; padding: 0.75rem 1rem; border-radius: var(--radius-pill); border: 1px solid transparent; font: inherit; font-weight: 500; font-size: 0.9rem; cursor: pointer; transition: background 0.15s, border-color 0.15s, opacity 0.15s; }
  .btn-primary { background: var(--fg); color: var(--bg); }
  .btn-primary:hover { opacity: 0.9; }
  .btn-primary svg { width: 16px; height: 16px; }
  .btn-ghost { background: transparent; color: var(--fg); border: 1px solid var(--border); font-size: 0.82rem; padding: 0.5rem 0.75rem; }
  .btn-ghost:hover:not(:disabled) { background: var(--bg); border-color: var(--border-strong); }
  .btn-ghost:disabled { opacity: 0.4; cursor: not-allowed; }
  .output { display: flex; align-items: center; gap: 0.5rem; margin-top: 1rem; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); padding: 0.6rem 0.4rem 0.6rem 0.9rem; word-break: break-all; }
  .output code { flex: 1; font-family: var(--mono); font-size: 0.85rem; color: var(--fg); }
  .copy-btn { background: transparent; border: none; color: var(--fg-muted); cursor: pointer; padding: 0.4rem; border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; }
  .copy-btn:hover { color: var(--fg); background: var(--border); }
  .copy-btn svg { width: 16px; height: 16px; }
  .bulk-output { margin-top: 1rem; max-height: 320px; overflow-y: auto; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); }
  .bulk-list { list-style: none; margin: 0; padding: 0.5rem; }
  .bulk-list li { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.35rem 0.5rem; border-radius: 6px; font-family: var(--mono); font-size: 0.8rem; color: var(--fg); word-break: break-all; }
  .bulk-list li:hover { background: var(--surface); }
  .bulk-list li button { background: transparent; border: none; color: var(--fg-muted); cursor: pointer; padding: 0.15rem 0.35rem; border-radius: 4px; font-size: 0.75rem; }
  .bulk-list li button:hover { color: var(--fg); background: var(--border); }
  .actions-row { display: flex; gap: 0.5rem; margin-top: 0.75rem; }
  .actions-row .btn { flex: 1; }
  .history { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid var(--border); }
  .history-head { display: flex; justify-content: space-between; align-items: center; font-size: 0.8rem; color: var(--fg-muted); font-weight: 500; margin-bottom: 0.5rem; }
  .link-btn { background: transparent; border: none; font: inherit; font-size: 0.78rem; color: var(--fg-muted); cursor: pointer; text-decoration: underline; padding: 0; }
  .link-btn:hover { color: var(--fg); }
  .history-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; max-height: 200px; overflow-y: auto; }
  .history-list li { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; font-family: var(--mono); font-size: 0.78rem; color: var(--fg-muted); padding: 0.3rem 0.4rem; border-radius: 6px; word-break: break-all; }
  .history-list li:hover { background: var(--bg); }
  .history-list .empty { color: var(--fg-dim); font-family: inherit; font-style: italic; }
</style>
